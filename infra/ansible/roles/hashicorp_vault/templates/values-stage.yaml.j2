# HashiCorp Vault – Stage (single replica, Raft integrated storage, Yandex KMS auto-unseal)
# Generated by Ansible – не редактировать вручную

# Yandex KMS auto-unseal: содержимое authorized-key.json сервис-аккаунта
yandexKmsAuthJson: |
  {{ hashicorp_vault_kms_auth_json | from_json | to_nice_json(indent=2) | indent(2) }}

global:
  enabled: true
  tlsDisable: true   # TLS терминируется на nginx ingress

injector:
  enabled: {{ hashicorp_vault_injector_enabled | lower }}

server:
  resources:
    requests:
      cpu: "{{ hashicorp_vault_resources_requests_cpu }}"
      memory: "{{ hashicorp_vault_resources_requests_memory }}"
    limits:
      cpu: "{{ hashicorp_vault_resources_limits_cpu }}"
      memory: "{{ hashicorp_vault_resources_limits_memory }}"

  extraEnvironmentVars:
    YANDEXCLOUD_KMS_KEY_ID: "{{ hashicorp_vault_kms_key_id }}"

  # Readiness probe принимает exit 2 (sealed but initialized)
  readinessProbe:
    exec:
      command:
        - /bin/sh
        - -ec
        - |
          vault status -tls-skip-verify
          EXIT=$?
          [ $EXIT -eq 0 ] || [ $EXIT -eq 2 ] && exit 0 || exit 1
    initialDelaySeconds: 5
    periodSeconds: 10
    failureThreshold: 6

  ha:
    enabled: false

  dataStorage:
    enabled: true
    size: "{{ hashicorp_vault_storage_size }}"
    storageClass: "{{ hashicorp_vault_storage_class }}"
    accessMode: ReadWriteOnce

  auditStorage:
    enabled: false

  standalone:
    enabled: true
    config: |
      ui = true

      listener "tcp" {
        tls_disable = 1
        address     = "[::]:8200"
        cluster_address = "[::]:8201"
      }

      storage "raft" {
        path    = "/vault/data"
        node_id = "vault-0"
      }

      service_registration "kubernetes" {}

ui:
  enabled: true
  serviceType: ClusterIP

ingress:
  enabled: {{ hashicorp_vault_ingress_enabled | lower }}
  ingressClassName: "{{ hashicorp_vault_ingress_class }}"
  annotations:
    cert-manager.io/cluster-issuer: "{{ hashicorp_vault_cluster_issuer }}"
  hosts:
    - host: "{{ hashicorp_vault_ingress_hostname }}"
      paths:
        - /
  tls:
    - secretName: vault-tls
      hosts:
        - "{{ hashicorp_vault_ingress_hostname }}"
