# Loki – prod values
# Chart: grafana/loki
# Storage: Yandex Object Storage (S3), target ~40 Gi / 30-day retention
# WAL/index PVC: 10 Gi yc-network-ssd

loki:
  auth_enabled: false

  commonConfig:
    replication_factor: 1

  storage:
    type: s3
    bucketNames:
      chunks: {{ loki_s3_bucket_name }}
      ruler: {{ loki_s3_bucket_name }}
    s3:
      endpoint: storage.yandexcloud.net
      region: ru-central1
      bucketnames: {{ loki_s3_bucket_name }}
      access_key_id: {{ loki_s3_access_key }}
      secret_access_key: {{ loki_s3_secret_key }}
      s3forcepathstyle: true
      insecure: false

  schemaConfig:
    configs:
      - from: "2024-04-01"
        store: tsdb
        object_store: s3
        schema: v13
        index:
          prefix: loki_index_
          period: 24h

  limits_config:
    allow_structured_metadata: true
    volume_enabled: true
    retention_period: {{ loki_prod_retention_period }}
    ingestion_rate_mb: 8
    ingestion_burst_size_mb: 16
    max_query_lookback: {{ loki_prod_retention_period }}

  compactor:
    working_directory: /var/loki/retention
    delete_request_store: s3
    retention_enabled: true
    retention_delete_delay: 2h
    retention_delete_worker_count: 150

# ── Deployment mode ───────────────────────────────────────────────────────────
deploymentMode: SingleBinary

singleBinary:
  replicas: 1

  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: 500m
      memory: 1Gi

  # WAL и index хранятся локально; чанки — в S3
  persistence:
    enabled: true
    size: {{ loki_wal_storage_size }}
    storageClass: {{ loki_wal_storage_class }}

# ── Disable microservice components ──────────────────────────────────────────
backend:
  replicas: 0
read:
  replicas: 0
write:
  replicas: 0
chunksCache:
  enabled: false
resultsCache:
  enabled: false
bloomCompactor:
  replicas: 0
bloomGateway:
  replicas: 0

gateway:
  enabled: false

minio:
  enabled: false

# ── Monitoring ────────────────────────────────────────────────────────────────
monitoring:
  selfMonitoring:
    enabled: false
    grafanaAgent:
      installOperator: false
  lokiCanary:
    enabled: false
  serviceMonitor:
    enabled: true
    labels:
      release: kube-prometheus-stack

test:
  enabled: false
