# Loki – stage values
# Chart: grafana/loki
# Storage: filesystem (yc-network-hdd), 15 Gi
# Retention: 7 days

loki:
  auth_enabled: false

  commonConfig:
    replication_factor: 1

  storage:
    type: filesystem

  schemaConfig:
    configs:
      - from: "2024-04-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index:
          prefix: loki_index_
          period: 24h

  limits_config:
    allow_structured_metadata: true
    volume_enabled: true
    retention_period: {{ loki_retention_period }}
    ingestion_rate_mb: 4
    ingestion_burst_size_mb: 8
    max_query_lookback: {{ loki_retention_period }}

  compactor:
    working_directory: /var/loki/retention
    delete_request_store: filesystem
    retention_enabled: true
    retention_delete_delay: 2h
    retention_delete_worker_count: 50

# ── Deployment mode ───────────────────────────────────────────────────────────
deploymentMode: SingleBinary

singleBinary:
  replicas: 1

  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      cpu: 300m
      memory: 512Mi

  persistence:
    enabled: true
    size: {{ loki_storage_size }}
    storageClass: {{ loki_storage_class }}

# ── Disable microservice components ──────────────────────────────────────────
backend:
  replicas: 0
read:
  replicas: 0
write:
  replicas: 0
chunksCache:
  enabled: false
resultsCache:
  enabled: false
bloomCompactor:
  replicas: 0
bloomGateway:
  replicas: 0

gateway:
  enabled: false

minio:
  enabled: false

# ── Monitoring ────────────────────────────────────────────────────────────────
monitoring:
  selfMonitoring:
    enabled: false
    grafanaAgent:
      installOperator: false
  lokiCanary:
    enabled: false
  serviceMonitor:
    enabled: true
    labels:
      release: kube-prometheus-stack

test:
  enabled: false
