# Promtail – values (единый шаблон для stage и prod)
# Chart: grafana/promtail
# Собирает логи со всех подов и отправляет в Loki

config:
  logLevel: info
  serverPort: 3101

  clients:
    - url: http://{{ loki_release_name }}.{{ loki_namespace }}.svc.cluster.local:3100/loki/api/v1/push
      tenant_id: ""
      timeout: 10s
      batchwait: 1s
      batchsize: 1048576

  positions:
    filename: /run/promtail/positions.yaml

  snippets:
    pipelineStages:
      - cri: {}

    # Переопределяем лейблы Loki-стримов из pod labels.
    # __meta_kubernetes_pod_label_<name> содержит значение pod label <name>.
    extraRelabelConfigs:
      # app = cards.backend / cards.frontend / otc.backend / ...
      - source_labels: [__meta_kubernetes_pod_label_app]
        target_label: app
        regex: (.+)
      # component = backend / frontend (для кросс-app фильтрации)
      - source_labels: [__meta_kubernetes_pod_label_component]
        target_label: component
        regex: (.+)
      # job = cards.backend вместо cards/app
      - source_labels: [__meta_kubernetes_pod_label_app]
        target_label: job
        regex: (.+)

updateStrategy:
  type: OnDelete

resources:
  requests:
    cpu: 20m
    memory: 64Mi
  limits:
    cpu: 100m
    memory: 128Mi

# Запускать на всех нодах, включая мастера
tolerations:
  - key: node-role.kubernetes.io/master
    operator: Exists
    effect: NoSchedule
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule
  - operator: Exists
    effect: NoSchedule

serviceMonitor:
  enabled: true
  labels:
    release: kube-prometheus-stack
